    <!-- ship_arg_l_trans_container_03_a_macro - Инкаркатура Защитник -->
    <cue name="Spawn_Ship_The_Imperial_Sreach">
      <conditions>
        <event_universe_generated />
      </conditions>
      <actions>
        <!-- Находим cектор -->
        <find_sector name="$TargetSector" macro="macro.coe_SE_c001_s001_macro" space="player.galaxy" required="true" />
        <do_if value="$TargetSector.exists">
          <!-- Координаты размещения корабля -->
          <create_position name="$ShipPlacement" space="$TargetSector" x="0m" y="-10000m" z="0m" />
          <!-- Создание корабля -->
          <create_ship name="$Ship" macro="macro.ship_arg_l_trans_container_03_a_macro" sector="$TargetSector" commandeerable="false" capturable="true">
            <owner exact="faction.ownerless" />
            <safepos value="$ShipPlacement" max="10000m" />
          </create_ship>
          <!-- Безопасное удаление пилота, если он сгенерировался -->
          <do_if value="$Ship.pilot.exists">
            <destroy_object object="$Ship.pilot" />
          </do_if>
          <!-- Настраиваем сильные повреждения корпуса и нулевые щиты -->
          <set_object_hull object="$Ship" min="40" max="75" />
          <set_object_shield object="$Ship" exact="0" />
          <!-- Создаем контейнер с безопасным радиусом спавна 10000 метров от корабля -->
          <create_lockbox name="$Lockbox" macro="macro.sm_gen_lockbox_common_01_macro" sector="$Ship.sector">
            <safepos value="$Ship.position" max="10000m" />
          </create_lockbox>
          <!-- Защищаем контейнер от случайного взрыва (прочность корпуса заблокирована на 100%) -->
          <set_object_min_hull object="$Lockbox" exact="100" />
          <!-- Наполняем ценным лутом -->
          <add_cargo object="$Lockbox" ware="ware.inv_seminar_piloting_4" exact="2" />
          <add_cargo object="$Lockbox" ware="ware.inv_seminar_management_4" exact="2" />
        </do_if>
      </actions>
      <cues>
        <!-- Очередь, отслеживающая сбор лута игроком -->
        <cue name="Spawn_Lockbox_The_Imperial_Sreach_Collected">
          <conditions>
            <!-- Срабатывает, когда замки отстрелены и контейнеры выпали -->
            <event_object_dropped_objects object="$Lockbox" />
          </conditions>
          <actions>
            <signal_cue cue="Give_Argon_Base_Blueprints_Kitstarter" />
            <signal_cue cue="Give_Argon_Trade_Blueprints_Kitstarter" />
            <!-- Снимаем бессмертие с сейфа -->
            <set_object_min_hull object="$Lockbox" exact="0" />
          </actions>
        </cue>
      </cues>
    </cue>

